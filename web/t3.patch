+import { describe, expect, it } from "@effect/vitest";
+
+import { dieWebPrincipal, isAllowedDieWebRequest, isDieWebNoAuthEnabled } from "./DieWebAuth.ts";
+
+describe("DieWebAuth", () => {
+  it("only enables no-auth for explicit web-mode loopback listeners", () => {
+    expect(
+      isDieWebNoAuthEnabled({
+        requested: true,
+        mode: "web",
+        host: "127.0.0.1",
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(true);
+    expect(
+      isDieWebNoAuthEnabled({
+        requested: false,
+        mode: "web",
+        host: "127.0.0.1",
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(false);
+    expect(
+      isDieWebNoAuthEnabled({
+        requested: true,
+        mode: "desktop",
+        host: "127.0.0.1",
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(false);
+    expect(
+      isDieWebNoAuthEnabled({
+        requested: true,
+        mode: "web",
+        host: "0.0.0.0",
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(false);
+    expect(
+      isDieWebNoAuthEnabled({
+        requested: true,
+        mode: "web",
+        host: undefined,
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(false);
+    expect(
+      isDieWebNoAuthEnabled({
+        requested: true,
+        mode: "web",
+        host: "::1",
+        tailscaleServeEnabled: true,
+      }),
+    ).toBe(false);
+  });
+
+  it("allows exact same-origin loopback browser HTTP and WebSocket requests", () => {
+    const requestUrl = new URL("http://127.0.0.1:3773/ws");
+    expect(
+      isAllowedDieWebRequest({
+        requestUrl,
+        origin: "http://127.0.0.1:3773",
+        secFetchSite: "same-origin",
+      }),
+    ).toBe(true);
+    expect(isAllowedDieWebRequest({ requestUrl, origin: undefined, secFetchSite: undefined })).toBe(
+      true,
+    );
+    expect(dieWebPrincipal.scopes).toContain("terminal:operate");
+    expect(dieWebPrincipal.scopes).toContain("orchestration:operate");
+  });
+
+  it.each([
+    ["external origin", "https://evil.example", "cross-site"],
+    ["wrong loopback port", "http://127.0.0.1:9999", "same-origin"],
+    ["opaque origin", "null", "cross-site"],
+    ["different loopback host", "http://localhost:3773", "same-origin"],
+  ])("rejects %s", (_label, origin, secFetchSite) => {
+    expect(
+      isAllowedDieWebRequest({
+        requestUrl: new URL("http://127.0.0.1:3773/api"),
+        origin,
+        secFetchSite,
+      }),
+    ).toBe(false);
+  });
+
+  it("rejects DNS-rebinding style nonloopback Host URLs", () => {
+    expect(
+      isAllowedDieWebRequest({
+        requestUrl: new URL("http://evil.example:3773/api"),
+        origin: "http://evil.example:3773",
+        secFetchSite: "same-origin",
+      }),
+    ).toBe(false);
+  });
+});
diff --git a/apps/server/src/auth/DieWebAuth.ts b/apps/server/src/auth/DieWebAuth.ts
new file mode 100644
index 00000000..56eda5fd
--- /dev/null
+++ b/apps/server/src/auth/DieWebAuth.ts
@@ -0,0 +1,66 @@
+import {
+  AuthAdministrativeScopes,
+  AuthSessionId,
+  type AuthEnvironmentScope,
+} from "@t3tools/contracts";
+
+import type { AuthenticatedSession } from "./EnvironmentAuth.ts";
+
+const LOOPBACK_BIND_HOSTS = new Set(["127.0.0.1", "::1", "localhost"]);
+export const DIE_WEB_SESSION_ID = AuthSessionId.make("die-web-loopback");
+
+export function isLoopbackBindHost(host: string | undefined): boolean {
+  if (host === undefined) return false;
+  const normalized = host
+    .trim()
+    .toLowerCase()
+    .replace(/^\[(.*)\]$/, "$1");
+  return LOOPBACK_BIND_HOSTS.has(normalized);
+}
+
+export function isDieWebNoAuthEnabled(input: {
+  readonly requested: boolean;
+  readonly mode: "web" | "desktop";
+  readonly host: string | undefined;
+  readonly tailscaleServeEnabled: boolean;
+}): boolean {
+  return (
+    input.requested &&
+    input.mode === "web" &&
+    isLoopbackBindHost(input.host) &&
+    !input.tailscaleServeEnabled
+  );
+}
+
+/**
+ * Browser requests in loopback no-auth mode must come from the exact server
+ * origin. This blocks cross-site fetches, forms, and WebSocket upgrades. Calls
+ * from local non-browser clients may omit browser origin metadata.
+ */
+export function isAllowedDieWebRequest(input: {
+  readonly requestUrl: URL | undefined;
+  readonly origin: string | undefined;
+  readonly secFetchSite: string | undefined;
+}): boolean {
+  const requestUrl = input.requestUrl;
+  if (requestUrl === undefined || !isLoopbackBindHost(requestUrl.hostname)) return false;
+
+  const fetchSite = input.secFetchSite?.trim().toLowerCase();
+  if (fetchSite !== undefined && fetchSite !== "same-origin" && fetchSite !== "none") return false;
+
+  if (input.origin === undefined) return true;
+  if (input.origin.trim().toLowerCase() === "null") return false;
+  try {
+    const origin = new URL(input.origin);
+    return isLoopbackBindHost(origin.hostname) && origin.origin === requestUrl.origin;
+  } catch {
+    return false;
+  }
+}
+
+export const dieWebPrincipal: AuthenticatedSession = {
+  sessionId: DIE_WEB_SESSION_ID,
+  subject: "die-web-loopback",
+  method: "browser-session-cookie",
+  scopes: [...AuthAdministrativeScopes] as ReadonlyArray<AuthEnvironmentScope>,
+};
