+    trimmedString(outputDetails?.agent) ??
+    trimmedString(outputDetails?.displayName) ??
+    trimmedString(outputDetails?.subagentType) ??
+    trimmedString(args.subagent_type);
+  if (!agent) return undefined;
+  const label = agent.replace(/[_-]+/gu, " ");
