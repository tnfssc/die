+  return {
+    itemType,
+    title,
+    ...(detail ? { detail } : {}),
+    data: {
+      ...(toolCallId ? { toolCallId } : {}),
+      toolName,
+      kind:
+        normalizedName === "bash"
+          ? "execute"
+          : normalizedName === "read"
+            ? "read"
+            : normalizedName === "write" || normalizedName === "edit"
+              ? "edit"
+              : mcpTool
+                ? "mcp"
+                : "other",
+      ...(command ? { command } : {}),
+      rawInput: args,
+      ...(outputRecord
+        ? {
+            rawOutput: {
+              ...(outputText ? { content: outputText } : {}),
+              ...(isRecord(outputRecord.details) ? outputRecord.details : {}),
+            },
+          }
+        : {}),
+      item: {
+        input: args,
+        ...(changes ? { changes } : {}),
+      },
+    },
+  };
+};
