+        ],
+        {
+          provider: "anthropic",
+          modelId: "claude/opus",
+          thinkingLevel: "high",
+        },
+      ),
+    ).toEqual([
+      {
+        slug: "anthropic/claude%2Fopus",
+        name: "Claude Opus",
+        subProvider: "anthropic",
+        isCustom: false,
+        isDefault: true,
+        capabilities: {
