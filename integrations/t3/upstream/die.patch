+it("preserves partial usage from failed/cancelled turns and exposes missing usage", () => {
+  const report = nativeThreadUsageReport(rootId, [
+    projection(rootId, null, null, [["root", complete(5, 1, true)]]),
+    projection(childId, rootId, "subagent", [
+      [
+        "failed",
+        {
+          usageScope: "main_agent",
