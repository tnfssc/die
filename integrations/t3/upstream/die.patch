index 000000000..9d2bb056c
--- /dev/null
+++ b/apps/server/src/provider/DieWebPi.test.ts
@@ -0,0 +1,42 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Schema from "effect/Schema";
+import { PiSettings } from "@t3tools/contracts";
+
+import { applyDieWebPiSettings, dieWebBinary, isTrustedDieProviderInstance } from "./DieWebPi.ts";
+
+const decode = Schema.decodeSync(PiSettings);
+
+describe("Die web Pi settings", () => {
+  it("uses the scoped Die executable and enables the RPC provider", () => {
+    const settings = applyDieWebPiSettings(
+      { ...decode({}), enabled: false, binaryPath: "pi" },
+      { DIE_WEB_DIE_BINARY: " /opt/die " },
+    );
+    assert.equal(settings.binaryPath, "/opt/die");
+    assert.isTrue(settings.enabled);
+  });
+
+  it("does not alter an ordinary Pi configuration", () => {
+    const settings = { ...decode({}), binaryPath: "/opt/pi" };
+    assert.strictEqual(applyDieWebPiSettings(settings, {}), settings);
+    assert.isUndefined(dieWebBinary({ DIE_WEB_DIE_BINARY: "  " }));
+  });
+});
+
+it("trusts only the built-in pi identity when server configuration replaces Pi with Die", () => {
+  const environment = { DIE_WEB_DIE_BINARY: "/opt/die" };
+  assert.isTrue(isTrustedDieProviderInstance("pi", environment));
