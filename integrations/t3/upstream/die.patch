new file mode 100644
index 000000000..c09c1fec6
--- /dev/null
+++ b/apps/server/src/provider/DieWebPi.ts
@@ -0,0 +1,29 @@
+import type { PiSettings } from "@t3tools/contracts";
+
+export const DIE_WEB_BINARY_ENV = "DIE_WEB_DIE_BINARY";
+
+export function dieWebBinary(environment: NodeJS.ProcessEnv): string | undefined {
+  const value = environment[DIE_WEB_BINARY_ENV]?.trim();
+  return value ? value : undefined;
+}
+
+/** Die web reuses the Pi RPC protocol, but owns its executable and tool surface. */
+export function applyDieWebPiSettings(
+  settings: PiSettings,
+  environment: NodeJS.ProcessEnv,
+): PiSettings {
+  const binaryPath = dieWebBinary(environment);
+  return binaryPath === undefined ? settings : { ...settings, enabled: true, binaryPath };
+}
+
+/**
+ * Native delegation authority is reserved for the built-in Pi instance when
+ * the server operator has replaced that runtime with Die. Provider/model
+ * environment is deliberately not an identity signal.
+ */
+export function isTrustedDieProviderInstance(
+  providerInstanceId: string,
+  environment: NodeJS.ProcessEnv,
+): boolean {
+  return providerInstanceId === "pi" && dieWebBinary(environment) !== undefined;
+}
