+  assert.equal(report.subtree.partialTurns, 1);
+  assert.equal(report.subtree.unavailableTurns, 1);
+  assert.equal(report.subtree.outputTokens, 5);
+  assert.equal(report.subtree.reasoningTokens, 2);
