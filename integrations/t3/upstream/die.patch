+import type { NativeThreadUsageReport } from "@t3tools/contracts";
+
+/** Only show cost once this thread or its delegated subtree has recorded a provider turn. */
+export function shouldShowNativeCostSummary(usage: NativeThreadUsageReport | null): boolean {
+  return usage !== null && (usage.own.turns > 0 || usage.subtree.turns > 0);
+}
