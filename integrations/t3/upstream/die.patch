+  assert.equal(report.own.inputTokens, 100);
+  assert.equal(report.subtree.turns, 4);
+  assert.equal(report.subtree.completeTurns, 4);
+  assert.equal(report.subtree.inputTokens, 157);
+  assert.equal(report.subtree.outputTokens, 16);
+  assert.equal(report.own.costUsd, 1.25);
+  assert.equal(report.subtree.costUsd, 1.82);
+  assert.equal(report.subtree.costKnownTurns, 4);
+  assert.equal(report.subtree.costStatus, "complete");
