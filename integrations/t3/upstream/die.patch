+  inputTokens,
+  cachedInputTokens: Math.floor(inputTokens / 2),
+  outputTokens,
+  ...(totalCostUsd === undefined ? {} : { totalCostUsd }),
+});
+
+it("counts every native descendant's own turns once without multiplying parent aggregates", () => {
+  const root = projection(rootId, null, null, [["root-turn", complete(100, 10, true, 1.25)]]);
+  const child = projection(childId, rootId, "subagent", [
+    ["child-attempt-1", complete(20, 2, true, 0.2)],
+    ["child-attempt-2", complete(30, 3, true, 0.3)], // retry/compaction is real additional use
+  ]);
+  const nested = projection(nestedId, childId, "subagent", [
+    ["nested-turn", complete(7, 1, false, 0.07)],
+  ]);
+  const fork = projection(ThreadId.make("fork"), rootId, "fork", [
+    ["fork-turn", complete(999, 999, false, 99)],
+  ]);
+
+  // Reconnect/replay can hand accounting the same turn again. The stronger
+  // final record wins and its stable provider-turn identity is still one unit.
+  const childReplay = projection(childId, rootId, "subagent", [
+    [
