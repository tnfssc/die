+import { describe, expect, it } from "vite-plus/test";
+import type { NativeThreadUsageReport, NativeUsageTotals } from "@t3tools/contracts";
+
+import { shouldShowNativeCostSummary } from "./nativeUsageCost.logic";
+
+const totals = (overrides: Partial<NativeUsageTotals> = {}): NativeUsageTotals => ({
+  turns: 0,
+  completeTurns: 0,
+  partialTurns: 0,
+  unavailableTurns: 0,
+  inputTokens: 0,
+  cachedInputTokens: 0,
+  cacheCreationTokens: 0,
+  outputTokens: 0,
+  reasoningTokens: 0,
+  costUsd: 0,
+  costKnownTurns: 0,
+  costUnavailableTurns: 0,
+  costStatus: "unavailable",
+  ...overrides,
+});
+
+const report = (
+  own: NativeUsageTotals,
+  subtree: NativeUsageTotals = own,
+): NativeThreadUsageReport => ({
+  own,
+  subtree,
+  descendantThreadIds: [],
+});
+
+describe("shouldShowNativeCostSummary", () => {
+  it("hides empty homepage usage before any turn is recorded", () => {
+    expect(shouldShowNativeCostSummary(null)).toBe(false);
+    expect(shouldShowNativeCostSummary(report(totals()))).toBe(false);
+  });
+
+  it("shows a legitimately zero-priced recorded turn", () => {
+    const zeroPriced = totals({
+      turns: 1,
+      completeTurns: 1,
+      costKnownTurns: 1,
+      costStatus: "complete",
+    });
+
+    expect(shouldShowNativeCostSummary(report(zeroPriced))).toBe(true);
+  });
+
+  it("shows unavailable cost when a real recorded turn lacks a price", () => {
+    const unknownCost = totals({
+      turns: 1,
+      unavailableTurns: 1,
+      costUnavailableTurns: 1,
+    });
+
+    expect(shouldShowNativeCostSummary(report(unknownCost))).toBe(true);
+  });
+
+  it("shows activity recorded only in the delegated subtree", () => {
+    const subtreeOnly = totals({
+      turns: 1,
+      completeTurns: 1,
+      costKnownTurns: 1,
+      costStatus: "complete",
+    });
+
+    expect(shouldShowNativeCostSummary(report(totals(), subtreeOnly))).toBe(true);
+  });
+});
