+  };
+  const base = { runs: [run], messages: [], providerThreads: [] };
+  const snapshots = [
+    { ...base, subagents: [{ status: "running" }] },
+    // Child finished, but native transfer has not yet been delivered.
+    {
+      ...base,
+      subagents: [
+        { status: "completed", completionDelivery: { state: "pending", observedByRunId: null } },
+      ],
+    },
+    {
+      ...base,
+      subagents: [
+        {
+          status: "completed",
+          completionDelivery: { state: "acknowledged", observedByRunId: null },
+        },
+      ],
+    },
+    // Reconnected projection repeats the settled state.
+    {
+      ...base,
+      subagents: [
+        {
+          status: "completed",
+          completionDelivery: { state: "acknowledged", observedByRunId: null },
+        },
+      ],
+    },
+  ] as const;
+
+  const states = snapshots.map((snapshot) => delegatedTaskProgress(snapshot as never).state);
+  assert.deepStrictEqual(states, [
+    "waiting_for_children",
+    "waiting_for_children",
+    "result_available",
+    "result_available",
+  ]);
+  const edges = states.filter((state, index) => index === 0 || state !== states[index - 1]);
+  assert.deepStrictEqual(edges, ["waiting_for_children", "result_available"]);
+});
diff --git a/apps/server/src/orchestration-v2/NativeUsageAccounting.ts b/apps/server/src/orchestration-v2/NativeUsageAccounting.ts
new file mode 100644
index 000000000..e8bcfa3bd
--- /dev/null
+++ b/apps/server/src/orchestration-v2/NativeUsageAccounting.ts
@@ -0,0 +1,124 @@
+import type {
+  OrchestrationV2AppThread,
+  OrchestrationV2ProviderTurn,
+  ThreadId,
+  TurnTokenUsage,
+  NativeThreadUsageReport,
+  NativeUsageTotals,
+} from "@t3tools/contracts";
+
+/**
+ * Minimal durable input needed to account for a native delegated thread tree.
+ * Provider turn ids are the accounting identity. A normalized turn already
+ * contains additive retry/compaction spend; replay/resume retains its id.
+ */
+export interface NativeUsageProjection {
+  readonly thread: Pick<OrchestrationV2AppThread, "id" | "lineage">;
+  readonly providerTurns: ReadonlyArray<Pick<OrchestrationV2ProviderTurn, "id" | "turnTokenUsage">>;
+}
+
+const emptyTotals = (): NativeUsageTotals => ({
+  turns: 0,
+  completeTurns: 0,
+  partialTurns: 0,
+  unavailableTurns: 0,
+  inputTokens: 0,
+  cachedInputTokens: 0,
+  cacheCreationTokens: 0,
+  outputTokens: 0,
+  reasoningTokens: 0,
+  costUsd: 0,
+  costKnownTurns: 0,
+  costUnavailableTurns: 0,
+  costStatus: "unavailable",
+});
+
+const usageRank = (usage: TurnTokenUsage | undefined): number => {
+  const status = usage?.usageStatus === "complete" ? 3 : usage?.usageStatus === "partial" ? 2 : 1;
+  // Prefer a replay carrying provider-reported spend over an otherwise equally
+  // complete legacy record. Old persisted turns legitimately omit costs.
+  return status * 10 + (usage?.totalCostUsd === undefined ? 0 : 1);
+};
+
+function addUsage(total: NativeUsageTotals, usage: TurnTokenUsage | undefined): NativeUsageTotals {
+  return {
+    turns: total.turns + 1,
+    completeTurns: total.completeTurns + (usage?.usageStatus === "complete" ? 1 : 0),
+    partialTurns: total.partialTurns + (usage?.usageStatus === "partial" ? 1 : 0),
+    unavailableTurns:
+      total.unavailableTurns + (usage === undefined || usage.usageStatus === "unavailable" ? 1 : 0),
+    inputTokens: total.inputTokens + (usage?.inputTokens ?? 0),
+    cachedInputTokens: total.cachedInputTokens + (usage?.cachedInputTokens ?? 0),
+    cacheCreationTokens: total.cacheCreationTokens + (usage?.cacheCreationTokens ?? 0),
+    outputTokens: total.outputTokens + (usage?.outputTokens ?? 0),
+    reasoningTokens: total.reasoningTokens + (usage?.reasoningTokens ?? 0),
+    costUsd: total.costUsd + (usage?.totalCostUsd ?? 0),
+    costKnownTurns: total.costKnownTurns + (usage?.totalCostUsd === undefined ? 0 : 1),
+    costUnavailableTurns: total.costUnavailableTurns + (usage?.totalCostUsd === undefined ? 1 : 0),
+    costStatus:
+      total.costKnownTurns + (usage?.totalCostUsd === undefined ? 0 : 1) === 0
+        ? "unavailable"
+        : total.costUnavailableTurns + (usage?.totalCostUsd === undefined ? 1 : 0) === 0
+          ? "complete"
+          : "partial",
+  };
+}
+
+/**
+ * Aggregates normalized per-turn main-agent usage without ever summing a
+ * provider/session aggregate. Duplicate projections and replayed terminal
+ * events collapse on provider turn id. Forks are deliberately excluded.
+ */
+export function nativeThreadUsageReport(
+  rootThreadId: ThreadId,
+  projections: ReadonlyArray<NativeUsageProjection>,
+): NativeThreadUsageReport {
+  const byThread = new Map(projections.map((projection) => [projection.thread.id, projection]));
+  const included = new Set<ThreadId>();
+  if (byThread.has(rootThreadId)) included.add(rootThreadId);
+
+  let changed = true;
+  while (changed) {
+    changed = false;
+    for (const projection of byThread.values()) {
+      const { parentThreadId, relationshipToParent } = projection.thread.lineage;
+      if (
+        !included.has(projection.thread.id) &&
+        relationshipToParent === "subagent" &&
+        parentThreadId !== null &&
+        included.has(parentThreadId)
+      ) {
+        included.add(projection.thread.id);
+        changed = true;
+      }
+    }
+  }
+
+  const selectedTurns = new Map<string, TurnTokenUsage | undefined>();
+  const ownTurnIds = new Set<string>();
+  for (const projection of projections) {
+    const threadId = projection.thread.id;
+    if (!included.has(threadId)) continue;
+    for (const turn of projection.providerTurns) {
+      const key = String(turn.id);
+      if (threadId === rootThreadId) ownTurnIds.add(key);
+      const current = selectedTurns.get(key);
+      if (!selectedTurns.has(key) || usageRank(turn.turnTokenUsage) >= usageRank(current)) {
+        selectedTurns.set(key, turn.turnTokenUsage);
+      }
+    }
+  }
+
+  let own = emptyTotals();
+  let subtree = emptyTotals();
+  for (const [turnId, usage] of selectedTurns) {
+    subtree = addUsage(subtree, usage);
+    if (ownTurnIds.has(turnId)) own = addUsage(own, usage);
+  }
+
+  return {
+    own,
+    subtree,
+    descendantThreadIds: [...included].filter((id) => id !== rootThreadId).sort(),
+  };
+}
