+export const HANDOFF_PROMPT_CACHE_LIMIT = 128;
+
+export function rememberHandoffPrompt(
+  promptsByDraft: Map<string, string>,
+  draftKey: string,
+  prompt: string,
+): void {
+  // The panel can outlive many drafts. Keep recent handoffs for replacement semantics without
+  // retaining complete prompt strings for every draft seen during the page lifetime.
+  promptsByDraft.delete(draftKey);
+  promptsByDraft.set(draftKey, prompt);
+
+  while (promptsByDraft.size > HANDOFF_PROMPT_CACHE_LIMIT) {
+    const oldestDraftKey = promptsByDraft.keys().next().value;
+    if (oldestDraftKey === undefined) break;
+    promptsByDraft.delete(oldestDraftKey);
+  }
+}
