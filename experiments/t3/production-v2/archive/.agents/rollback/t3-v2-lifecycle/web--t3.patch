+import { describe, expect, it } from "@effect/vitest";
+
+import {
+  isHostProcessExecutable,
+  withBunSelfExecEnvironment,
+  withoutBunSelfExecEnvironment,
+} from "./hostProcess.ts";
+
+describe("host process runtime compatibility", () => {
+  it("only treats Node SEA hosts as the T3 single executable", () => {
+    expect(isHostProcessExecutable({ isSea: true })).toBe(true);
+    expect(isHostProcessExecutable({ isSea: false })).toBe(false);
+  });
+
+  it("scopes BUN_BE_BUN to deliberate interpreter children", () => {
+    const parent = { PATH: "/bin", BUN_BE_BUN: "stale" };
+    expect(withBunSelfExecEnvironment(parent, true)).toEqual({
+      PATH: "/bin",
+      BUN_BE_BUN: "1",
+    });
+    expect(withBunSelfExecEnvironment(parent, false)).toEqual({ PATH: "/bin" });
+    expect(withoutBunSelfExecEnvironment(parent)).toEqual({ PATH: "/bin" });
+    expect(parent.BUN_BE_BUN).toBe("stale");
+  });
+});
