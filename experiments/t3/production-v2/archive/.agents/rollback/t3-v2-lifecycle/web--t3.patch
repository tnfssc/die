+import { runPromise } from "./apps/server/node_modules/effect/dist/Effect.js";
+
+const adapter = make(Bun);
+let p;
+let output = "";
+const timeout = (promise) => new Promise((resolve, reject) => {
+  const timer = setTimeout(() => reject(new Error("native Bun PTY timed out")), 5000);
+  promise.then(
+    (value) => { clearTimeout(timer); resolve(value); },
+    (error) => { clearTimeout(timer); reject(error); },
+  );
+});
+try {
+  p = await runPromise(adapter.spawn({
+    shell: "/bin/bash",
+    args: ["--noprofile", "--norc"],
+    cwd: process.env.TEST_HOME,
+    cols: 80,
+    rows: 24,
+    env: { HOME: process.env.TEST_HOME, PATH: process.env.PATH, PS1: "" },
+  }));
+  p.onData((data) => { output += data; });
+  let didExit = false;
+  const exited = new Promise((resolve) => p.onExit((event) => {
+    didExit = true;
+    resolve(event);
+  }));
+  await Bun.sleep(process.env.TEST_MODE === "interactive" ? 250 : 100);
+  if (process.env.TEST_MODE === "interactive") {
+    if (didExit) throw new Error("interactive shell exited before delayed input");
+    p.resize(101, 37);
+    p.write("printf '__BUN_PTY_READY__\n'; stty size; exit 0\n");
+  } else {
+    p.kill("SIGKILL");
+  }
+  const event = await timeout(exited);
+  console.log(JSON.stringify({ pid: p.pid, output, event }));
+} finally {
+  try { p?.kill("SIGKILL"); } catch {}
+}
+`;
+
+const runNativeCase = (mode: "interactive" | "kill") =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+      const home = yield* fs.makeTempDirectoryScoped({
+        directory: process.env.TMPDIR ?? "/var/tmp",
+        prefix: "t3-bun-pty-",
+      });
+      yield* fs.chmod(home, 0o700);
+      // Resolve Bun through PATH: Vitest runs under Node, so globalThis.Bun is absent.
+      yield* spawner.exitCode(ChildProcess.make("bun", ["--version"]));
+      const stdout = yield* spawner.string(
+        ChildProcess.make("bun", ["--eval", childProgram], {
+          cwd: path.resolve(import.meta.dirname, "../../../.."),
+          env: { ...process.env, TEST_HOME: home, TEST_MODE: mode },
+        }),
+      );
+      const line = stdout.trim().split("\n").at(-1);
+      assert.isDefined(line);
+      return yield* Schema.decodeUnknownEffect(
+        Schema.fromJsonString(
+          Schema.Struct({
+            pid: Schema.Int,
+            output: Schema.String,
+            event: Schema.Struct({ exitCode: Schema.Int, signal: Schema.NullOr(Schema.Int) }),
+          }),
+        ),
+      )(line!);
+    }),
+  );
+
+const nativeLayer = NodeServices.layer;
+
+it.effect("uses Bun's native terminal for delayed interactive output, resize, and clean exit", () =>
+  runNativeCase("interactive").pipe(
+    Effect.tap((result) =>
+      Effect.sync(() => {
+        assert.isAbove(result.pid, 0);
+        assert.equal(result.event.exitCode, 0);
+        assert.equal(result.event.signal, null);
+        assert.include(result.output, "__BUN_PTY_READY__");
+        assert.match(result.output, /37\s+101/);
+      }),
+    ),
+    Effect.provide(nativeLayer),
+  ),
+);
+
+it.effect("kills its own native terminal subprocess handle", () =>
+  runNativeCase("kill").pipe(
+    Effect.tap((result) =>
+      Effect.sync(() => {
+        assert.isAbove(result.pid, 0);
+        assert.isTrue(result.event.signal === 9 || result.event.exitCode !== 0);
+      }),
+    ),
+    Effect.provide(nativeLayer),
+  ),
+);
diff --git a/apps/server/src/terminal/BunPtyAdapter.ts b/apps/server/src/terminal/BunPtyAdapter.ts
new file mode 100644
index 00000000..350de371
--- /dev/null
+++ b/apps/server/src/terminal/BunPtyAdapter.ts
@@ -0,0 +1,186 @@
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+
+import * as PtyAdapter from "./PtyAdapter.ts";
+
+/** The small portion of Bun's native terminal API used by the server. */
+interface BunTerminal {
+  write(data: string | Uint8Array): unknown;
+  resize(cols: number, rows: number): void;
+  close(): void;
+}
+
+interface BunSubprocess {
+  readonly pid: number;
+  readonly exited: Promise<number>;
+  readonly signalCode: unknown;
+  readonly terminal?: BunTerminal;
+  kill(signal?: string): unknown;
+}
+
+export interface BunTerminalRuntime {
+  spawn(
+    command: string[],
+    options: {
+      cwd: string;
+      env: NodeJS.ProcessEnv;
+      terminal: {
+        cols: number;
+        rows: number;
+        data(terminal: BunTerminal, bytes: Uint8Array): void;
+      };
+    },
+  ): BunSubprocess;
+}
+
+const nativeRuntime = (): BunTerminalRuntime | undefined => {
+  const bun = (globalThis as unknown as { Bun?: unknown }).Bun;
+  if (typeof bun !== "object" || bun === null || !("spawn" in bun)) return undefined;
+  return bun as BunTerminalRuntime;
+};
+
+/** Injectable to keep node-pty unit tests independent of the test runner runtime. */
+export const BunTerminalRuntimeRef = Context.Reference<BunTerminalRuntime | undefined>(
+  "server/terminal/BunTerminalRuntime",
+  { defaultValue: nativeRuntime },
+);
+
+const signalNumber = (signal: unknown): number | null => {
+  if (typeof signal === "number") return signal;
+  if (typeof signal !== "string") return null;
+  // Bun currently exposes POSIX signal names. Keep this local so the native
+  // path does not need Bun types or another platform service.
+  return (
+    (
+      {
+        SIGHUP: 1,
+        SIGINT: 2,
+        SIGQUIT: 3,
+        SIGKILL: 9,
+        SIGTERM: 15,
+      } as Record<string, number>
+    )[signal] ?? null
+  );
+};
+
+class BunPtyProcess implements PtyAdapter.PtyProcess {
+  private readonly dataListeners = new Set<(data: string) => void>();
+  private readonly exitListeners = new Set<(event: PtyAdapter.PtyExitEvent) => void>();
+  private readonly pendingData: string[] = [];
+  private hasHadDataListener = false;
+  private exitEvent: PtyAdapter.PtyExitEvent | undefined;
+
+  private readonly process: BunSubprocess;
+  private readonly terminal: BunTerminal;
+
+  constructor(process: BunSubprocess, terminal: BunTerminal) {
+    this.process = process;
+    this.terminal = terminal;
+  }
+
+  get pid(): number {
+    return this.process.pid;
+  }
+
+  write(data: string): void {
+    this.terminal.write(data);
+  }
+
+  resize(cols: number, rows: number): void {
+    this.terminal.resize(cols, rows);
+  }
+
+  kill(signal?: string): void {
+    this.process.kill(signal);
+  }
+
+  onData(callback: (data: string) => void): () => void {
+    this.dataListeners.add(callback);
+    if (!this.hasHadDataListener) {
+      this.hasHadDataListener = true;
+      for (const data of this.pendingData.splice(0)) callback(data);
+    }
+    return () => {
+      this.dataListeners.delete(callback);
+    };
+  }
+
+  onExit(callback: (event: PtyAdapter.PtyExitEvent) => void): () => void {
+    this.exitListeners.add(callback);
+    if (this.exitEvent !== undefined) callback(this.exitEvent);
+    return () => {
+      this.exitListeners.delete(callback);
+    };
+  }
+
+  emitData(data: string): void {
+    if (data.length === 0) return;
+    if (!this.hasHadDataListener) {
+      this.pendingData.push(data);
+      return;
+    }
+    for (const listener of this.dataListeners) listener(data);
+  }
+
+  emitExit(exitCode: number): void {
+    if (this.exitEvent !== undefined) return;
+    this.exitEvent = { exitCode, signal: signalNumber(this.process.signalCode) };
+    for (const listener of this.exitListeners) listener(this.exitEvent);
+  }
+}
+
+export const make = (runtime: BunTerminalRuntime) =>
+  PtyAdapter.PtyAdapter.of({
+    spawn: Effect.fn("BunPtyAdapter.spawn")(function* (input) {
+      const decoder = new TextDecoder();
+      let adapterProcess: BunPtyProcess | undefined;
+      const earlyData: string[] = [];
+
+      const subprocess = yield* Effect.try({
+        try: () =>
+          runtime.spawn([input.shell, ...(input.args ?? [])], {
+            cwd: input.cwd,
+            env: { ...input.env, TERM: input.env["TERM"] ?? "xterm-256color" },
+            terminal: {
+              cols: input.cols,
+              rows: input.rows,
+              data: (_terminal, bytes) => {
+                const data = decoder.decode(bytes, { stream: true });
+                if (adapterProcess === undefined) earlyData.push(data);
+                else adapterProcess.emitData(data);
+              },
+            },
+          }),
+        catch: (cause) =>
+          new PtyAdapter.PtySpawnError({
+            adapter: "bun-terminal",
+            shell: input.shell,
+            cause,
+          }),
+      });
+
+      const terminal = subprocess.terminal;
+      if (terminal === undefined) {
+        return yield* new PtyAdapter.PtySpawnError({
+          adapter: "bun-terminal",
+          shell: input.shell,
+          cause: new Error("Bun.spawn did not return a native terminal handle."),
+        });
+      }
+
+      adapterProcess = new BunPtyProcess(subprocess, terminal);
+      for (const data of earlyData) adapterProcess.emitData(data);
+
+      void subprocess.exited.then((exitCode) => {
+        adapterProcess!.emitData(decoder.decode());
+        adapterProcess!.emitExit(exitCode);
+        try {
+          terminal.close();
+        } catch {
+          // The terminal may already have been closed by the subprocess exit.
+        }
+      });
+
+      return adapterProcess;
+    }),
+  });
