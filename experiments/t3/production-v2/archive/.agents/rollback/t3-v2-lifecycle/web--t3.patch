+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import { ChildProcess, ChildProcessSpawner } from "effect/unstable/process";
+import * as BunPtyAdapter from "./BunPtyAdapter.ts";
+import * as PtyAdapter from "./PtyAdapter.ts";
+
+type FakeState = {
+  command: string[];
+  options: unknown;
+  writes: string[];
+  resize: [number, number][];
+  kills: (string | undefined)[];
+  emitData: (bytes: Uint8Array) => void;
+};
+
+const fakeAdapter = () => {
+  let emitData = (_bytes: Uint8Array) => {};
+  const state: FakeState = {
+    command: [],
+    options: undefined,
+    writes: [],
+    resize: [],
+    kills: [],
+    emitData,
+  };
+  const terminal = {
+    write: (data: string) => state.writes.push(data),
+    resize: (cols: number, rows: number) => state.resize.push([cols, rows]),
+    close: () => {},
+  };
+  const subprocess = {
+    pid: 42,
+    signalCode: undefined,
+    terminal,
+    kill: (signal?: string) => state.kills.push(signal),
+    exited: new Promise<number>(() => {}),
+  };
+  const runtime = {
+    spawn: (command: string[], options: any) => {
+      state.command = command;
+      state.options = options;
+      emitData = options.terminal.data;
+      state.emitData = emitData;
+      return subprocess;
+    },
+  };
+  return { adapter: BunPtyAdapter.make(runtime as any), state };
+};
+
+it.effect("forwards shell arguments and terminal dimensions", () =>
+  Effect.gen(function* () {
+    const { adapter, state } = fakeAdapter();
+    yield* adapter.spawn({
+      shell: "sh",
+      args: ["-c", "echo ok"],
+      cwd: "/tmp",
+      cols: 80,
+      rows: 24,
+      env: {},
+    });
+    assert.deepEqual(state.command, ["sh", "-c", "echo ok"]);
+    assert.deepEqual((state.options as any).terminal, {
+      cols: 80,
+      rows: 24,
+      data: (state.options as any).terminal.data,
+    });
+  }),
+);
+
+it.effect("adds the default terminal environment", () =>
+  Effect.gen(function* () {
+    const { adapter, state } = fakeAdapter();
+    yield* adapter.spawn({ shell: "sh", cwd: "/tmp", cols: 80, rows: 24, env: { FOO: "bar" } });
+    assert.deepEqual((state.options as any).env, { FOO: "bar", TERM: "xterm-256color" });
+  }),
+);
+
+it.effect("preserves a caller-provided TERM", () =>
+  Effect.gen(function* () {
+    const { adapter, state } = fakeAdapter();
+    yield* adapter.spawn({
+      shell: "sh",
+      cwd: "/tmp",
+      cols: 80,
+      rows: 24,
+      env: { TERM: "xterm-direct" },
+    });
+    assert.equal((state.options as any).env.TERM, "xterm-direct");
+  }),
+);
+
+it.effect("exposes pid and forwards terminal writes", () =>
+  Effect.gen(function* () {
+    const { adapter, state } = fakeAdapter();
+    const process = yield* adapter.spawn({ shell: "sh", cwd: "/tmp", cols: 80, rows: 24, env: {} });
+    assert.equal(process.pid, 42);
+    process.write("hello");
+    assert.deepEqual(state.writes, ["hello"]);
+  }),
+);
+
+it.effect("forwards resize requests", () =>
+  Effect.gen(function* () {
+    const { adapter, state } = fakeAdapter();
+    const process = yield* adapter.spawn({ shell: "sh", cwd: "/tmp", cols: 80, rows: 24, env: {} });
+    process.resize(101, 37);
+    assert.deepEqual(state.resize, [[101, 37]]);
+  }),
+);
+
+it.effect("forwards kill signals", () =>
+  Effect.gen(function* () {
+    const { adapter, state } = fakeAdapter();
+    const process = yield* adapter.spawn({ shell: "sh", cwd: "/tmp", cols: 80, rows: 24, env: {} });
+    process.kill("SIGTERM");
+    process.kill();
+    assert.deepEqual(state.kills, ["SIGTERM", undefined]);
+  }),
+);
+
+const childProgram = String.raw`
