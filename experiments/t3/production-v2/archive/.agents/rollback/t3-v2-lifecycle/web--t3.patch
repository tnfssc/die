+const pruneFinishedExtensionTasks = <T extends { readonly state: string }>(
+  tasks: Map<string, T>,
+) => {
+  let finished = 0;
+  for (const task of tasks.values()) if (task.state !== "running") finished += 1;
+  if (finished <= MAX_FINISHED_EXTENSION_TASKS) return;
+  for (const [key, task] of tasks) {
+    if (task.state === "running") continue;
+    tasks.delete(key);
+    finished -= 1;
+    if (finished <= MAX_FINISHED_EXTENSION_TASKS) return;
+  }
+};
