+/** Mark only a deliberate Bun-as-interpreter child; never inherit the marker accidentally. */
+export const withBunSelfExecEnvironment = (
+  environment: NodeJS.ProcessEnv,
+  isBun: boolean,
+): NodeJS.ProcessEnv => {
+  const next = { ...environment };
+  delete next.BUN_BE_BUN;
+  if (isBun) next.BUN_BE_BUN = "1";
+  return next;
+};
+
+/** A normal CLI or RPC child must execute the compiled application, not Bun's interpreter mode. */
+export const withoutBunSelfExecEnvironment = (
+  environment: NodeJS.ProcessEnv,
+): NodeJS.ProcessEnv => {
+  if (!("BUN_BE_BUN" in environment)) return environment;
+  const next = { ...environment };
+  delete next.BUN_BE_BUN;
+  return next;
+};
