index 00000000..d5839ea0
--- /dev/null
+++ b/apps/server/src/terminal/SubscriberStream.test.ts
@@ -0,0 +1,143 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Cause from "effect/Cause";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Stream from "effect/Stream";
+
+import {
+  boundedTerminalSubscriberStream,
+  TERMINAL_SUBSCRIBER_BUFFER_SIZE,
+  TerminalSubscriberOverflowError,
+} from "./SubscriberStream.ts";
+
+describe("bounded terminal subscriber stream", () => {
+  it.effect(
+    "disconnects a real slow consumer at the upstream bound without stalling a healthy one",
+    () =>
+      Effect.gen(function* () {
+        const listeners = new Set<(event: number) => Effect.Effect<void>>();
+        const bothRegistered = yield* Deferred.make<void>();
+        const releaseSlowConsumer = yield* Deferred.make<void>();
+
+        const subscribe = (listener: (event: number) => Effect.Effect<void>) =>
+          Effect.sync(() => {
+            listeners.add(listener);
+            return () => {
+              listeners.delete(listener);
+            };
+          }).pipe(
+            Effect.tap(() =>
+              listeners.size === 2 ? Deferred.succeed(bothRegistered, undefined) : Effect.void,
+            ),
+          );
+
+        const slowValues: number[] = [];
+        const slow = yield* boundedTerminalSubscriberStream(subscribe).pipe(
+          Stream.runForEach((value) =>
+            Effect.gen(function* () {
+              slowValues.push(value);
+              if (value === 0) yield* Deferred.await(releaseSlowConsumer);
+            }),
+          ),
+          Effect.forkScoped,
+        );
+
+        const healthyValues: number[] = [];
+        const healthy = yield* boundedTerminalSubscriberStream(subscribe).pipe(
+          Stream.runForEach((value) => Effect.sync(() => healthyValues.push(value))),
+          Effect.forkScoped,
+        );
+
+        yield* Deferred.await(bothRegistered);
+
+        const produced = TERMINAL_SUBSCRIBER_BUFFER_SIZE * 8;
+        for (let value = 0; value < produced; value += 1) {
+          // These are manager-side listener calls. The slow stream's RPC/downstream
+          // consumer is blocked above, so this saturates the upstream callback queue.
+          for (const listener of listeners) yield* listener(value);
+          yield* Effect.yieldNow;
+        }
+
+        // Saturation removes only the slow registration. If this were merely the
+        // downstream ACK window, both manager-side listeners would still be live.
+        assert.equal(listeners.size, 1);
+        assert.deepEqual(
+          healthyValues,
+          Array.from({ length: produced }, (_, index) => index),
+        );
+
+        yield* Deferred.succeed(releaseSlowConsumer, undefined);
+        const slowExit = yield* Fiber.await(slow);
+        assert.isTrue(Exit.isFailure(slowExit));
+        if (Exit.isFailure(slowExit)) {
+          const error = Cause.squash(slowExit.cause);
+          assert.instanceOf(error, TerminalSubscriberOverflowError);
+          assert.equal((error as TerminalSubscriberOverflowError).reason, "events");
+        }
+
+        assert.equal(slowValues.length, TERMINAL_SUBSCRIBER_BUFFER_SIZE + 1);
+        assert.deepEqual(
+          slowValues,
+          Array.from({ length: TERMINAL_SUBSCRIBER_BUFFER_SIZE + 1 }, (_, index) => index),
+        );
+
+        // The healthy stream remains attached and ordered after the slow stream's
+        // explicit completion.
+        for (let value = produced; value < produced + 10; value += 1) {
+          for (const listener of listeners) yield* listener(value);
+          yield* Effect.yieldNow;
+        }
+        assert.deepEqual(
+          healthyValues,
+          Array.from({ length: produced + 10 }, (_, index) => index),
+        );
+
+        yield* Fiber.interrupt(healthy);
+      }).pipe(Effect.scoped),
+  );
+
+  it.effect("bounds retained serialized bytes and reports byte overflow", () =>
+    Effect.gen(function* () {
+      const listeners = new Set<(event: string) => Effect.Effect<void>>();
+      const registered = yield* Deferred.make<void>();
+      const releaseConsumer = yield* Deferred.make<void>();
+      const stream = boundedTerminalSubscriberStream(
+        (listener: (event: string) => Effect.Effect<void>) =>
+          Effect.sync(() => {
+            listeners.add(listener);
+            return () => listeners.delete(listener);
+          }).pipe(Effect.tap(() => Deferred.succeed(registered, undefined))),
+        { maxBufferBytes: 10, sizeOf: (event) => Buffer.byteLength(event) },
+      );
+
+      const values: string[] = [];
+      const fiber = yield* stream.pipe(
+        Stream.runForEach((value) =>
+          Effect.gen(function* () {
+            values.push(value);
+            if (value === "x") yield* Deferred.await(releaseConsumer);
+          }),
+        ),
+        Effect.forkScoped,
+      );
+      yield* Deferred.await(registered);
+      for (const listener of listeners) yield* listener("x");
+      yield* Effect.yieldNow;
+      for (const listener of listeners) yield* listener("123456");
+      for (const listener of listeners) yield* listener("78901");
+
+      assert.equal(listeners.size, 0);
+      yield* Deferred.succeed(releaseConsumer, undefined);
+      const exit = yield* Fiber.await(fiber);
+      assert.isTrue(Exit.isFailure(exit));
+      if (Exit.isFailure(exit)) {
+        const error = Cause.squash(exit.cause);
+        assert.instanceOf(error, TerminalSubscriberOverflowError);
+        assert.equal((error as TerminalSubscriberOverflowError).reason, "bytes");
+      }
+      assert.deepEqual(values, ["x", "123456"]);
+    }).pipe(Effect.scoped),
+  );
+});
diff --git a/apps/server/src/terminal/SubscriberStream.ts b/apps/server/src/terminal/SubscriberStream.ts
new file mode 100644
index 00000000..3f662777
--- /dev/null
+++ b/apps/server/src/terminal/SubscriberStream.ts
@@ -0,0 +1,144 @@
+import * as Cause from "effect/Cause";
+import * as Effect from "effect/Effect";
+import * as Queue from "effect/Queue";
+import * as Stream from "effect/Stream";
+
+/** Maximum number of terminal events retained between one subscriber and RPC. */
+export const TERMINAL_SUBSCRIBER_BUFFER_SIZE = 32;
+
+/**
+ * The attach snapshot can contain the bounded 8 MiB terminal history. Leave
+ * room for worst-case JSON escaping (up to 6x for control characters) plus
+ * queued output, while still bounding unusually large PTY writes independently
+ * of the event-count limit.
+ */
+export const TERMINAL_SUBSCRIBER_BUFFER_BYTES = 64 * 1024 * 1024;
+
+export class TerminalSubscriberOverflowError extends Error {
+  readonly _tag = "TerminalSubscriberOverflowError";
+  readonly reason: "events" | "bytes";
+  readonly pendingBytes: number;
+  readonly eventBytes: number;
+
+  constructor(reason: "events" | "bytes", pendingBytes: number, eventBytes: number) {
+    super(
+      `Terminal subscriber backlog exceeded its ${reason} limit (pending=${pendingBytes}, event=${eventBytes})`,
+    );
+    this.name = "TerminalSubscriberOverflowError";
+    this.reason = reason;
+    this.pendingBytes = pendingBytes;
+    this.eventBytes = eventBytes;
+  }
+}
+
+interface BufferedEvent<A> {
+  readonly event: A;
+  readonly release: () => void;
+}
+
+interface SubscriberStreamOptions<A> {
+  readonly maxBufferBytes?: number;
+  readonly sizeOf?: (event: A) => number;
+}
+
+const serializedSize = (event: unknown): number => {
+  // Terminal events are RPC JSON values. Measuring their serialized form also
+  // includes snapshot/history and envelope fields, unlike string-length caps.
+  const serialized = JSON.stringify(event);
+  return serialized === undefined ? 0 : Buffer.byteLength(serialized);
+};
+
+/**
+ * Adapt a terminal listener registration to a bounded stream.
+ *
+ * Overflow fails (rather than normally ending) the subscription after already
+ * accepted events. RPC therefore exposes a recognizable defect and terminal
+ * clients can reconnect and obtain a fresh snapshot instead of silently
+ * freezing on a live websocket.
+ */
+export function boundedTerminalSubscriberStream<A, E>(
+  subscribe: (listener: (event: A) => Effect.Effect<void>) => Effect.Effect<() => void, E>,
+  options: SubscriberStreamOptions<A> = {},
+): Stream.Stream<A, E> {
+  const maxBufferBytes = options.maxBufferBytes ?? TERMINAL_SUBSCRIBER_BUFFER_BYTES;
+  const sizeOf = options.sizeOf ?? serializedSize;
+
+  return Stream.callback<BufferedEvent<A>, E>(
+    (queue) => {
+      let unsubscribe: (() => void) | null = null;
+      let disconnected = false;
+      let pendingBytes = 0;
+
+      const disconnect = (error: TerminalSubscriberOverflowError) =>
+        Effect.sync(() => {
+          if (disconnected) return false;
+          disconnected = true;
+          unsubscribe?.();
+          unsubscribe = null;
+          return true;
+        }).pipe(
+          Effect.flatMap((shouldFail) =>
+            shouldFail ? Queue.failCause(queue, Cause.die(error)) : Effect.succeed(false),
+          ),
+          Effect.asVoid,
+        );
+
+      const offer = (event: A) =>
+        Effect.suspend(() => {
+          if (disconnected) return Effect.void;
+          const eventBytes = Math.max(0, sizeOf(event));
+          if (eventBytes > maxBufferBytes - pendingBytes) {
+            return disconnect(
+              new TerminalSubscriberOverflowError("bytes", pendingBytes, eventBytes),
+            );
+          }
+
+          pendingBytes += eventBytes;
+          let released = false;
+          const release = () => {
+            if (released) return;
+            released = true;
+            pendingBytes = Math.max(0, pendingBytes - eventBytes);
+          };
+          return Queue.offer(queue, { event, release }).pipe(
+            Effect.flatMap((accepted) => {
+              if (accepted) return Effect.void;
+              release();
+              return disconnect(
+                new TerminalSubscriberOverflowError("events", pendingBytes, eventBytes),
+              );
+            }),
+          );
+        });
+
+      return Effect.acquireRelease(
+        subscribe(offer).pipe(
+          Effect.map((release) => {
+            let released = false;
+            const releaseOnce = () => {
+              if (released) return;
+              released = true;
+              release();
+            };
+            if (disconnected) releaseOnce();
+            else unsubscribe = releaseOnce;
+            return releaseOnce;
+          }),
+        ),
+        (release) =>
+          Effect.sync(() => {
+            if (unsubscribe === release) unsubscribe = null;
+            release();
+          }),
+      );
+    },
+    { bufferSize: TERMINAL_SUBSCRIBER_BUFFER_SIZE, strategy: "dropping" },
+  ).pipe(
+    Stream.mapEffect(({ event, release }) =>
+      Effect.sync(() => {
+        release();
+        return event;
+      }),
+    ),
+  );
+}
