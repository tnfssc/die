+  it.effect("retires idle thread locks without splitting holders from queued waiters", () =>
+    Effect.gen(function* () {
+      const locks = yield* makePiThreadLockRegistry;
+      const threadId = ThreadId.make("serialized-thread");
+      const firstEntered = yield* Deferred.make<void>();
+      const secondEntered = yield* Deferred.make<void>();
+      const thirdEntered = yield* Deferred.make<void>();
+      const firstGate = yield* Deferred.make<void>();
+      const secondGate = yield* Deferred.make<void>();
+      const thirdGate = yield* Deferred.make<void>();
+      let active = 0;
+      let maximumActive = 0;
+      const run = (entered: Deferred.Deferred<void>, gate: Deferred.Deferred<void>) =>
+        locks.withLock(
+          threadId,
+          Effect.gen(function* () {
+            active += 1;
+            maximumActive = Math.max(maximumActive, active);
+            yield* Deferred.succeed(entered, undefined);
+            yield* Deferred.await(gate);
+            active -= 1;
+          }),
+        );
+
+      const first = yield* run(firstEntered, firstGate).pipe(Effect.forkChild);
+      yield* Deferred.await(firstEntered);
+      const second = yield* run(secondEntered, secondGate).pipe(Effect.forkChild);
+      while ((yield* locks.users(threadId)) < 2) yield* Effect.yieldNow;
+      assert.equal(yield* locks.size, 1);
+
+      yield* Deferred.succeed(firstGate, undefined);
+      yield* Deferred.await(secondEntered);
+      const third = yield* run(thirdEntered, thirdGate).pipe(Effect.forkChild);
+      while ((yield* locks.users(threadId)) < 2) yield* Effect.yieldNow;
+      assert.equal(Option.isNone(yield* Deferred.poll(thirdEntered)), true);
+      assert.equal(yield* locks.size, 1);
+
+      yield* Deferred.succeed(secondGate, undefined);
+      yield* Deferred.await(thirdEntered);
+      yield* Deferred.succeed(thirdGate, undefined);
+      yield* Fiber.join(first);
+      yield* Fiber.join(second);
+      yield* Fiber.join(third);
+      assert.equal(maximumActive, 1);
+      assert.equal(yield* locks.size, 0);
+    }),
+  );
