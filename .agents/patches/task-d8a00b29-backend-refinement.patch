diff --git a/apps/server/src/mcp/DieDelegationPolicy.ts b/apps/server/src/mcp/DieDelegationPolicy.ts
new file mode 100644
index 000000000..f7c6b10d4
--- /dev/null
+++ b/apps/server/src/mcp/DieDelegationPolicy.ts
@@ -0,0 +1,140 @@
+// @effect-diagnostics nodeBuiltinImport:off,preferSchemaOverJson:off
+import type {
+  DieTaskProfile,
+  ModelSelection,
+  OrchestratorMcpTarget,
+  OrchestrationV2ThreadProjection,
+  ThreadId,
+} from "@t3tools/contracts";
+import { readFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+import type { DieDelegationPolicy } from "./McpInvocationContext.ts";
+
+export const DIE_DELEGATION_MAX_DEPTH = 2;
+export const DIE_PROMPT_MARKER = "<die-delegation-v1>";
+const PROFILES = new Set<DieTaskProfile>(["fast", "normal", "orchestrator"]);
+const THINKING = new Set([
+  "off",
+  "minimal",
+  "low",
+  "medium",
+  "high",
+  "xhigh",
+  "max",
+]);
+
+export function profileFromMarkedPrompt(
+  prompt: string,
+): DieTaskProfile | undefined {
+  if (!prompt.startsWith(DIE_PROMPT_MARKER)) return undefined;
+  const match =
+    /^<die-delegation-v1> profile=(fast|normal|orchestrator)(?:\s|$)/.exec(
+      prompt,
+    );
+  return match && PROFILES.has(match[1] as DieTaskProfile)
+    ? (match[1] as DieTaskProfile)
+    : undefined;
+}
+
+/** Derives role/depth only from trusted process mode and persisted parent/task lineage. */
+export async function deriveDieDelegationPolicy(
+  threadId: ThreadId,
+  trustedDieBackend: boolean,
+  load: (threadId: ThreadId) => Promise<OrchestrationV2ThreadProjection>,
+): Promise<DieDelegationPolicy | undefined> {
+  if (!trustedDieBackend) return undefined;
+  let current = await load(threadId);
+  if (current.thread.lineage.parentThreadId === null)
+    return { profile: "orchestrator", depth: 0 };
+  let depth = 0;
+  let profile: DieTaskProfile | undefined;
+  const seen = new Set<string>();
+  while (current.thread.lineage.parentThreadId !== null) {
+    if (
+      current.thread.lineage.relationshipToParent !== "subagent" ||
+      seen.has(current.thread.id)
+    )
+      return undefined;
+    seen.add(current.thread.id);
+    const parent = await load(current.thread.lineage.parentThreadId);
+    const edge = parent.subagents.find(
+      (task) => task.childThreadId === current.thread.id,
+    );
+    const edgeProfile =
+      edge === undefined ? undefined : profileFromMarkedPrompt(edge.prompt);
+    if (edgeProfile === undefined) return undefined;
+    profile ??= edgeProfile;
+    depth += 1;
+    current = parent;
+  }
+  return profile === undefined ? undefined : { profile, depth };
+}
+
+type ProfileConfig = { readonly model?: string; readonly thinking?: string };
+function validModel(value: unknown): value is string {
+  return (
+    typeof value === "string" &&
+    value === value.trim() &&
+    value.includes("/") &&
+    !/\s/.test(value) &&
+    !value.startsWith("/") &&
+    !value.endsWith("/")
+  );
+}
+
+/** Reads Die's user configuration in the trusted backend process, never provider-supplied env. */
+export async function resolveDieProfileSelection(
+  profile: DieTaskProfile,
+  parent: ModelSelection,
+  configPath?: string,
+): Promise<OrchestratorMcpTarget> {
+  const path =
+    configPath ??
+    (process.env.DIE_SUBAGENT_PROFILES_PATH?.trim() ||
+      join(homedir(), ".die", "subagents.json"));
+  let raw: unknown = {};
+  try {
+    raw = JSON.parse(await readFile(path, "utf8"));
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT")
+      throw new Error(
+        `Invalid Die subagent profile config at ${path}: ${String(error)}`,
+      );
+  }
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw))
+    throw new Error(`Invalid Die subagent profile config at ${path}.`);
+  const candidate = (raw as Record<string, unknown>)[profile];
+  if (
+    candidate !== undefined &&
+    (typeof candidate !== "object" ||
+      candidate === null ||
+      Array.isArray(candidate))
+  )
+    throw new Error(`Invalid Die ${profile} profile at ${path}.`);
+  const config = (candidate ?? {}) as ProfileConfig;
+  if (config.model !== undefined && !validModel(config.model))
+    throw new Error(`Invalid model in Die ${profile} profile at ${path}.`);
+  if (config.thinking !== undefined && !THINKING.has(config.thinking))
+    throw new Error(
+      `Invalid thinking level in Die ${profile} profile at ${path}.`,
+    );
+  const inheritedThinking = parent.options?.find(
+    (option) => option.id === "thinking",
+  )?.value;
+  const thinking =
+    config.thinking ??
+    (typeof inheritedThinking === "string" ? inheritedThinking : undefined);
+  const model = config.model ?? parent.model;
+  if (model === undefined || model.length === 0)
+    throw new Error(`No model is available for Die ${profile} profile.`);
+  return {
+    providerInstanceId: parent.instanceId,
+    model,
+    options: [
+      { id: "instructionMode", value: profile },
+      ...(thinking === undefined ? [] : [{ id: "thinking", value: thinking }]),
+    ],
+  };
+}
