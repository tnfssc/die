+// @effect-diagnostics nodeBuiltinImport:off
+import { expect, it } from "@effect/vitest";
+import { mkdtemp, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+import {
+  deriveDieDelegationPolicy,
+  resolveDieProfileSelection,
+} from "./DieDelegationPolicy.ts";
+
+it("resolves exact trusted fast/normal model and thinking configuration", async () => {
+  const dir = await mkdtemp("/var/tmp/die-profiles-");
+  const path = join(dir, "subagents.json");
+  await writeFile(
+    path,
+    JSON.stringify({
+      fast: { model: "vendor/fast-model", thinking: "low" },
+      normal: { model: "vendor/normal-model", thinking: "high" },
+    }),
+  );
+  const parent = {
+    instanceId: "pi",
+    model: "vendor/parent",
+    options: [{ id: "thinking", value: "medium" }],
+  } as any;
+  await expect(
+    resolveDieProfileSelection("fast", parent, path),
+  ).resolves.toEqual({
+    providerInstanceId: "pi",
+    model: "vendor/fast-model",
+    options: [
+      { id: "instructionMode", value: "fast" },
+      { id: "thinking", value: "low" },
+    ],
+  });
+  await expect(
+    resolveDieProfileSelection("normal", parent, path),
+  ).resolves.toEqual({
+    providerInstanceId: "pi",
+    model: "vendor/normal-model",
+    options: [
+      { id: "instructionMode", value: "normal" },
+      { id: "thinking", value: "high" },
+    ],
+  });
+});
+
+it("derives role and depth only from trusted durable lineage", async () => {
+  const root = {
+    thread: {
+      id: "root",
+      lineage: { parentThreadId: null, relationshipToParent: null },
+    },
+    subagents: [
+      {
+        childThreadId: "child",
+        prompt: "<die-delegation-v1> profile=normal\nwork",
+      },
+    ],
+  } as any;
+  const child = {
+    thread: {
+      id: "child",
+      lineage: { parentThreadId: "root", relationshipToParent: "subagent" },
+    },
+    subagents: [],
+  } as any;
+  const values = new Map([
+    ["root", root],
+    ["child", child],
+  ]);
+  const load = async (id: any) => values.get(id)!;
+  await expect(
+    deriveDieDelegationPolicy("child" as any, false, load),
+  ).resolves.toBeUndefined();
+  await expect(
+    deriveDieDelegationPolicy("child" as any, true, load),
+  ).resolves.toEqual({
+    profile: "normal",
+    depth: 1,
+  });
+  root.subagents[0].prompt = "caller-forged profile=orchestrator";
+  await expect(
+    deriveDieDelegationPolicy("child" as any, true, load),
+  ).resolves.toBeUndefined();
+});
diff --git a/apps/server/src/mcp/DieTaskService.ts b/apps/server/src/mcp/DieTaskService.ts
new file mode 100644
index 000000000..315b95f22
--- /dev/null
+++ b/apps/server/src/mcp/DieTaskService.ts
@@ -0,0 +1,357 @@
+import {
+  type DieTaskCancelInput,
+  type DieTaskLaunchInput,
+  type DieTaskListInput,
+  type DieTaskListResult,
+  type DieTaskProfile,
+  type DieTaskResult,
+  NodeId,
+  OrchestratorMcpFailure,
+  type OrchestrationV2Run,
+  type OrchestrationV2Subagent,
+  type OrchestrationV2ThreadProjection,
+  type ThreadId,
+} from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+
+import {
+  delegatedTaskProgress,
+  subagentResultForRun,
+} from "../orchestration-v2/SubagentProjection.ts";
+import {
+  latestActiveRun,
+  ThreadManagementService,
+} from "../orchestration-v2/ThreadManagementService.ts";
+import type { McpInvocationScope } from "./McpInvocationContext.ts";
+import {
+  delegatedTaskRun,
+  hasPendingChildRuns,
+  OrchestratorMcpService,
+} from "./OrchestratorMcpService.ts";
+import {
+  DIE_DELEGATION_MAX_DEPTH,
+  DIE_PROMPT_MARKER,
+  profileFromMarkedPrompt,
+  resolveDieProfileSelection,
+} from "./DieDelegationPolicy.ts";
+
+const MAX_OBSERVED_OUTPUT_CHARS = 64_000;
+const DEFAULT_LIST_COUNT = 20;
+
+const rolePrompt: Record<DieTaskProfile, string> = {
+  fast: "Act as a focused fast worker. Solve the bounded task directly and report a concise result.",
+  normal:
+    "Act as an implementation worker. Complete the task, verify the result, and report concrete evidence.",
+  orchestrator:
+    "Act as an orchestrator. Decompose when useful, coordinate delegated work, verify integration, and report one coherent result.",
+};
+const encodedPrompt = (profile: DieTaskProfile, prompt: string) =>
+  `${DIE_PROMPT_MARKER} profile=${profile}\n${rolePrompt[profile]}\n\n${prompt}`;
+const fail = (code: OrchestratorMcpFailure["code"], message: string) =>
+  new OrchestratorMcpFailure({ code, message });
+function statusForRun(
+  run: OrchestrationV2Run | undefined,
+): DieTaskResult["status"] {
+  switch (run?.status) {
+    case "completed":
+      return "completed";
+    case "failed":
+      return "failed";
+    case "cancelled":
+    case "rolled_back":
+    case "interrupted":
+      return "cancelled";
+    default:
+      return "running";
+  }
+}
+
+export interface DieTaskServiceShape {
+  readonly launch: (
+    scope: McpInvocationScope,
+    input: DieTaskLaunchInput,
+  ) => Effect.Effect<DieTaskResult, OrchestratorMcpFailure>;
+  readonly observe: (
+    scope: McpInvocationScope,
+    taskId: NodeId,
+  ) => Effect.Effect<DieTaskResult, OrchestratorMcpFailure>;
+  readonly cancel: (
+    scope: McpInvocationScope,
+    input: DieTaskCancelInput,
+  ) => Effect.Effect<DieTaskResult, OrchestratorMcpFailure>;
+  readonly list: (
+    scope: McpInvocationScope,
+    input: DieTaskListInput,
+  ) => Effect.Effect<DieTaskListResult, OrchestratorMcpFailure>;
+}
+export class DieTaskService extends Context.Service<
+  DieTaskService,
+  DieTaskServiceShape
+>()("t3/mcp/DieTaskService") {}
+
+const make = Effect.gen(function* () {
+  const threadManagement = yield* ThreadManagementService;
+  const orchestrator = yield* OrchestratorMcpService;
+  const load = (threadId: ThreadId) =>
+    threadManagement
+      .getThreadProjection(threadId)
+      .pipe(
+        Effect.mapError((error) =>
+          fail(
+            "orchestration_error",
+            `Unable to read delegation state: ${String(error)}`,
+          ),
+        ),
+      );
+  const requireDieScope = (scope: McpInvocationScope) =>
+    Effect.gen(function* () {
+      if (
+        !scope.capabilities.has("die-delegation") ||
+        scope.dieDelegation === undefined
+      )
+        return yield* fail(
+          "capability_denied",
+          "The bearer credential is not authorized for native Die delegation.",
+        );
+      const projection = yield* load(scope.threadId);
+      return { projection, policy: scope.dieDelegation };
+    });
+  const ownedTask = (
+    projection: OrchestrationV2ThreadProjection,
+    taskId: NodeId,
+  ) => {
+    const task = projection.subagents.find(
+      (candidate) =>
+        candidate.id === taskId &&
+        candidate.origin === "app_owned" &&
+        profileFromMarkedPrompt(candidate.prompt) !== undefined,
+    );
+    return task?.childThreadId === null || task === undefined
+      ? undefined
+      : task;
+  };
+  const resultFor = (
+    parent: OrchestrationV2ThreadProjection,
+    task: OrchestrationV2Subagent,
+    parentDepth: number,
+    includeOutput: boolean,
+  ) =>
+    Effect.gen(function* () {
+      if (task.childThreadId === null)
+        return yield* fail(
+          "task_not_found",
+          `Die task ${task.id} has no child thread.`,
+        );
+      const child = yield* load(task.childThreadId);
+      const run = delegatedTaskRun(child, task);
+      const profile = profileFromMarkedPrompt(task.prompt);
+      if (profile === undefined)
+        return yield* fail(
+          "orchestration_error",
+          `Die task ${task.id} has no durable profile.`,
+        );
+      const progress = delegatedTaskProgress(child);
+      const effectiveRun = progress.resultRun ?? run;
+      const status = hasPendingChildRuns(child, run)
+        ? "running"
+        : statusForRun(effectiveRun);
+      const rawOutput =
+        status === "running"
+          ? undefined
+          : (task.result ??
+            (effectiveRun
+              ? subagentResultForRun(child, effectiveRun).text
+              : undefined) ??
+            undefined);
+      const outputTruncated =
+        rawOutput !== undefined && rawOutput.length > MAX_OBSERVED_OUTPUT_CHARS;
+      const output =
+        !includeOutput || rawOutput === undefined
+          ? undefined
+          : outputTruncated
+            ? rawOutput.slice(0, MAX_OBSERVED_OUTPUT_CHARS)
+            : rawOutput;
+      const transfer = parent.contextTransfers.find(
+        (candidate) =>
+          candidate.type === "subagent_result" &&
+          candidate.sourceThreadId === task.childThreadId &&
+          candidate.targetThreadId === parent.thread.id &&
+          (effectiveRun === undefined ||
+            candidate.sourcePoint.runId === undefined ||
+            candidate.sourcePoint.runId === effectiveRun.id),
+      );
+      return {
+        version: 1 as const,
+        taskId: task.id,
+        childThreadId: task.childThreadId,
+        ...(run ? { childRunId: run.id } : {}),
+        childNodeId: task.id,
+        status,
+        profile,
+        depth: parentDepth + 1,
+        ...(output === undefined ? {} : { output }),
+        ...(includeOutput && outputTruncated ? { outputTruncated: true } : {}),
+        ...(transfer === undefined ? {} : { transferId: transfer.id }),
+      };
+    });
+
+  const launch: DieTaskServiceShape["launch"] = (scope, input) =>
+    Effect.gen(function* () {
+      const parent = yield* requireDieScope(scope);
+      if (input.timeoutMs !== undefined)
+        return yield* fail(
+          "invalid_request",
+          "timeoutMs is a child-runtime deadline, which this backend does not yet support; no task was launched.",
+        );
+      if (parent.policy.profile !== "orchestrator")
+        return yield* fail(
+          "capability_denied",
+          `Die ${parent.policy.profile} sessions may not delegate.`,
+        );
+      if (parent.policy.depth >= DIE_DELEGATION_MAX_DEPTH)
+        return yield* fail(
+          "capability_denied",
+          `Maximum Die delegation depth ${DIE_DELEGATION_MAX_DEPTH} reached.`,
+        );
+      const parentSelection =
+        latestActiveRun(parent.projection)?.modelSelection ??
+        parent.projection.thread.modelSelection;
+      const target = yield* Effect.tryPromise({
+        try: () => resolveDieProfileSelection(input.profile, parentSelection),
+        catch: (error) => fail("invalid_request", String(error)),
+      });
+      const prompt = encodedPrompt(input.profile, input.prompt);
+      const internalScope = {
+        ...scope,
+        capabilities: new Set([
+          ...scope.capabilities,
+          "orchestration" as const,
+        ]),
+      };
+      const delegated = yield* orchestrator.delegateTask(internalScope, {
+        task: prompt,
+        mode: "async",
+        clientRequestId: input.clientRequestId,
+        target,
+      });
+      const refreshed = yield* load(scope.threadId);
+      const task = ownedTask(refreshed, delegated.taskId);
+      if (task === undefined)
+        return yield* fail(
+          "orchestration_error",
+          "Native Die launch did not create durable task lineage.",
+        );
+      if (task.prompt !== prompt)
+        return yield* fail(
+          "invalid_request",
+          "clientRequestId was already used with different launch arguments.",
+        );
+      return {
+        version: 1 as const,
+        taskId: task.id,
+        childThreadId: task.childThreadId!,
+        ...(delegated.childRunId === null
+          ? {}
+          : { childRunId: delegated.childRunId }),
+        childNodeId: task.id,
+        status: "running" as const,
+        profile: input.profile,
+        depth: parent.policy.depth + 1,
+      };
+    });
+  const observe: DieTaskServiceShape["observe"] = (scope, taskId) =>
+    Effect.gen(function* () {
+      const parent = yield* requireDieScope(scope);
+      const task = ownedTask(parent.projection, taskId);
+      if (task === undefined)
+        return yield* fail(
+          "task_not_found",
+          `Die task ${taskId} does not belong to this provider thread.`,
+        );
+      return yield* resultFor(
+        parent.projection,
+        task,
+        parent.policy.depth,
+        true,
+      );
+    });
+  const list: DieTaskServiceShape["list"] = (scope, input) =>
+    Effect.gen(function* () {
+      const parent = yield* requireDieScope(scope);
+      const all = parent.projection.subagents.filter(
+        (task) =>
+          task.origin === "app_owned" &&
+          task.childThreadId !== null &&
+          profileFromMarkedPrompt(task.prompt) !== undefined,
+      );
+      const offset = input.cursor === undefined ? 0 : Number(input.cursor);
+      if (!Number.isSafeInteger(offset) || offset < 0 || offset > all.length)
+        return yield* fail(
+          "invalid_request",
+          "die_task_list cursor is invalid or stale.",
+        );
+      const count = input.count ?? DEFAULT_LIST_COUNT;
+      const tasks: DieTaskResult[] = [];
+      for (const task of all.slice(offset, offset + count))
+        tasks.push(
+          yield* resultFor(parent.projection, task, parent.policy.depth, false),
+        );
+      const next = offset + tasks.length;
+      return {
+        tasks,
+        total: all.length,
+        ...(next < all.length ? { nextCursor: String(next) } : {}),
+      };
+    });
+  const cancel: DieTaskServiceShape["cancel"] = (scope, input) =>
+    Effect.gen(function* () {
+      const parent = yield* requireDieScope(scope);
+      const root = ownedTask(parent.projection, input.taskId);
+      if (root === undefined)
+        return yield* fail(
+          "task_not_found",
+          `Die task ${input.taskId} does not belong to this provider thread.`,
+        );
+      const cancelChildren = (
+        parentScope: McpInvocationScope,
+        task: OrchestrationV2Subagent,
+      ): Effect.Effect<void, OrchestratorMcpFailure> =>
+        Effect.gen(function* () {
+          if (task.childThreadId === null) return;
+          const child = yield* load(task.childThreadId);
+          for (const descendant of child.subagents)
+            if (
+              descendant.origin === "app_owned" &&
+              descendant.childThreadId !== null
+            )
+              yield* cancelChildren(
+                { ...parentScope, threadId: task.childThreadId! },
+                descendant,
+              );
+          const internalScope = {
+            ...parentScope,
+            capabilities: new Set([
+              ...parentScope.capabilities,
+              "orchestration" as const,
+            ]),
+          };
+          yield* orchestrator.cancelTask(internalScope, {
+            taskId: task.id,
+            clientRequestId: `die-cancel:${scope.threadId}:${input.taskId}:${task.id}`,
+            reason: "Explicit native Die subtree cancellation.",
+          });
+        });
+      yield* cancelChildren(scope, root);
+      const refreshed = yield* load(scope.threadId);
+      return yield* resultFor(
+        refreshed,
+        ownedTask(refreshed, input.taskId) ?? root,
+        parent.policy.depth,
+        true,
+      );
+    });
+  return { launch, observe, cancel, list } satisfies DieTaskServiceShape;
+});
+export const layer = Layer.effect(DieTaskService, make);
diff --git a/apps/server/src/mcp/DieTaskService.test.ts b/apps/server/src/mcp/DieTaskService.test.ts
new file mode 100644
index 000000000..31340d0d7
--- /dev/null
+++ b/apps/server/src/mcp/DieTaskService.test.ts
@@ -0,0 +1,265 @@
+// @effect-diagnostics anyEffect:off
+import { expect, it } from "@effect/vitest";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+
+import { ThreadManagementService } from "../orchestration-v2/ThreadManagementService.ts";
+import { DieTaskService, layer } from "./DieTaskService.ts";
+import { OrchestratorMcpService } from "./OrchestratorMcpService.ts";
+
+const now = "2026-01-01T00:00:00.000Z";
+const scope = {
+  environmentId: "env",
+  threadId: "thread-parent",
+  providerSessionId: "session-parent",
+  providerInstanceId: "pi",
+  capabilities: new Set(["die-delegation"]),
+  dieDelegation: { profile: "orchestrator", depth: 0 },
+  issuedAt: 1,
+} as any;
+const thread = (
+  id: string,
+  parent: string | null,
+  profile: "fast" | "normal" | "orchestrator",
+) =>
+  ({
+    thread: {
+      id,
+      lineage: {
+        parentThreadId: parent,
+        relationshipToParent: parent === null ? null : "subagent",
+        rootThreadId: "thread-parent",
+      },
+      modelSelection: {
+        instanceId: "pi",
+        model: "default",
+        options: [{ id: "instructionMode", value: profile }],
+      },
+    },
+    runs: [],
+    messages: [],
+    providerThreads: [],
+    subagents: [],
+    contextTransfers: [],
+  }) as any;
+
+it.effect(
+  "launches asynchronously, reads without ACK, deduplicates, and cancels only the subtree",
+  () =>
+    Effect.gen(function* () {
+      const parent = thread("thread-parent", null, "orchestrator");
+      const child = thread("thread-child", "thread-parent", "normal");
+      child.runs.push({
+        id: "run-child",
+        threadId: "thread-child",
+        status: "running",
+        ordinal: 1,
+        startedAt: now,
+        modelSelection: child.thread.modelSelection,
+      });
+      const grandchild = thread("thread-grandchild", "thread-child", "fast");
+      grandchild.runs.push({
+        id: "run-grandchild",
+        threadId: "thread-grandchild",
+        status: "running",
+        ordinal: 1,
+        startedAt: now,
+        modelSelection: grandchild.thread.modelSelection,
+      });
+      const projections = new Map([
+        ["thread-parent", parent],
+        ["thread-child", child],
+        ["thread-grandchild", grandchild],
+      ]);
+      const delegated: any[] = [];
+      const cancelled: any[] = [];
+      const orchestrator = {
+        delegateTask: (_scope: any, input: any) =>
+          Effect.sync(() => {
+            delegated.push(input);
+            if (parent.subagents.length === 0)
+              parent.subagents.push({
+                id: "node-child",
+                threadId: "thread-parent",
+                childThreadId: "thread-child",
+                origin: "app_owned",
+                prompt: input.task,
+                status: "running",
+                result: null,
+                providerInstanceId: "pi",
+                model: "default",
+                updatedAt: now,
+              });
+            return {
+              taskId: "node-child",
+              childThreadId: "thread-child",
+              childRunId: "run-child",
+              childNodeId: "node-child",
+            };
+          }),
+        cancelTask: (callScope: any, input: any) =>
+          Effect.sync(() => {
+            cancelled.push([callScope.threadId, input.taskId]);
+            return { taskId: input.taskId, status: "cancel_requested" };
+          }),
+      } as any;
+      const services = Layer.mergeAll(
+        Layer.succeed(ThreadManagementService, {
+          getThreadProjection: (id: string) =>
+            Effect.succeed(projections.get(id)!),
+        } as any),
+        Layer.succeed(OrchestratorMcpService, orchestrator),
+      );
+      const built = yield* Layer.build(layer.pipe(Layer.provide(services)));
+      const service = Context.get(built, DieTaskService);
+      const launched = yield* service.launch(scope, {
+        clientRequestId: "request-1",
+        prompt: "Implement feature",
+        profile: "normal",
+      });
+      expect(launched).toEqual({
+        version: 1,
+        taskId: "node-child",
+        childThreadId: "thread-child",
+        childRunId: "run-child",
+        childNodeId: "node-child",
+        status: "running",
+        profile: "normal",
+        depth: 1,
+      });
+      expect(delegated[0]).toMatchObject({
+        mode: "async",
+        clientRequestId: "request-1",
+        target: {
+          providerInstanceId: "pi",
+          options: [{ id: "instructionMode", value: "normal" }],
+        },
+      });
+
+      child.runs[0].status = "completed";
+      parent.subagents[0].status = "completed";
+      parent.subagents[0].result = "done";
+      parent.contextTransfers.push({
+        id: "transfer-1",
+        type: "subagent_result",
+        sourceThreadId: "thread-child",
+        targetThreadId: "thread-parent",
+        sourcePoint: { runId: "run-child" },
+      });
+      expect(
+        (yield* service.observe(scope, "node-child" as never)).output,
+      ).toBe("done");
+      expect((yield* service.list(scope, {})).tasks).toHaveLength(1);
+      expect(cancelled).toHaveLength(0);
+
+      child.subagents.push({
+        id: "node-grandchild",
+        threadId: "thread-child",
+        childThreadId: "thread-grandchild",
+        origin: "app_owned",
+        prompt: "nested",
+        status: "running",
+        result: null,
+      });
+      yield* service.cancel(scope, { taskId: "node-child" as never });
+      expect(cancelled).toEqual([
+        ["thread-child", "node-grandchild"],
+        ["thread-parent", "node-child"],
+      ]);
+    }),
+);
+
+it.effect(
+  "rejects fast/normal parents, depth overflow, and conflicting request replay",
+  () =>
+    Effect.gen(function* () {
+      const parent = thread("thread-parent", null, "orchestrator");
